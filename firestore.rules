rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isUserAdmin(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) && 
             get(/databases/$(database)/documents/users/$(uid)).data.get('isAdmin', false) == true;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'xenned12@gmail.com' ||
        isUserAdmin(request.auth.uid)
      );
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidPublicBooking(data) {
      return data.keys().hasAll(['date', 'time', 'status', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.date is string && data.date.size() == 10 &&
             data.time is string && data.time.size() <= 15 &&
             data.status is string && data.status.size() <= 20 &&
             data.createdAt is timestamp;
    }

    function isValidPrivateBooking(data) {
      return data.keys().hasAll(['fullName', 'email', 'phone', 'sessionType', 'createdAt']) &&
             data.keys().size() == 5 &&
             data.fullName is string && data.fullName.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.sessionType is string && data.sessionType.size() <= 50 &&
             data.createdAt is timestamp;
    }

    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidSupportChat(data, userId) {
      return data.keys().hasAll(['userId', 'updatedAt']) &&
             data.userId == userId &&
             data.updatedAt == request.time &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 100)) &&
             (!('userName' in data) || (data.userName is string && data.userName.size() <= 100)) &&
             (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 1000));
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['text', 'senderId', 'timestamp', 'isAdmin']) &&
             data.text is string && data.text.size() <= 2000 &&
             data.senderId == request.auth.uid &&
             data.timestamp == request.time &&
             data.isAdmin is bool &&
             (!('senderEmail' in data) || (data.senderEmail is string && data.senderEmail.size() <= 100));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'isAdmin']) &&
             data.email is string && data.email.size() <= 100 &&
             data.isAdmin is bool &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100));
    }

    match /users/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid && 
                       isValidUser(incoming()) && 
                       incoming().isAdmin == false; 
      allow update: if (request.auth != null && request.auth.uid == uid && 
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName'])) ||
                       isAdmin();
    }

    match /admin_otps/{uid} {
      allow read, write: if false; // Server-side logic only
    }

    match /public_bookings/{bookingId} {
      // allow anyone to list public bookings to determine availability
      allow list, get: if true;
      
      allow create: if isValidId(bookingId) &&
                       isValidPublicBooking(incoming()) &&
                       incoming().createdAt == request.time &&
                       incoming().status == 'pending';
                       
      // Admins update the status
      allow update: if isAdmin() &&
                       isValidPublicBooking(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                       incoming().date == existing().date &&
                       incoming().time == existing().time &&
                       incoming().createdAt == existing().createdAt;
                       
      allow delete: if isAdmin();
    }

    match /private_bookings/{bookingId} {
      allow read: if isAdmin();
      
      allow create: if isValidId(bookingId) &&
                       isValidPrivateBooking(incoming()) &&
                       incoming().createdAt == request.time &&
                       existsAfter(/databases/$(database)/documents/public_bookings/$(bookingId));
                       
      allow update: if false; // Only status in public_bookings is updated
      allow delete: if isAdmin();
    }

    match /support_chats/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      
      allow create, update: if (isVerified() && request.auth.uid == userId && isValidSupportChat(incoming(), userId)) ||
                               (isAdmin() && isValidSupportChat(incoming(), userId));
                               
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow list, get: if request.auth != null && (request.auth.uid == userId || isAdmin());
        
        allow create: if (isVerified() && request.auth.uid == userId && isValidChatMessage(incoming()) && incoming().isAdmin == false) ||
                         (isAdmin() && isValidChatMessage(incoming()) && incoming().isAdmin == true);
                         
        allow update, delete: if isAdmin();
      }
    }
  }
}
